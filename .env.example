# Образец локальных настроек стенда.
#
#   cp .env.example .env    и заполнить значения
#
# Файл .env в git не попадает (см. .gitignore). Переменные, переданные в
# командной строке, приоритетнее значений отсюда:
#   PROJECT_ID=other-project ./scripts/bootstrap.sh

# --- Обязательное -----------------------------------------------------------

# Проект GCP с привязанным биллингом.
PROJECT_ID=

# Телеграм-бот для уведомлений CI/CD и алертов Alertmanager.
# Токен: @BotFather -> /newbot
# chat_id: добавить бота в группу и открыть
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Необязательное: значения по умолчанию подходят -------------------------

# Регион и зона. Зона должна принадлежать региону.
#REGION=europe-central2
#ZONE=europe-central2-a

# Имя кластера. Используется и как префикс имён ресурсов
# (сеть, пул WIF, сервисный аккаунт).
#CLUSTER_NAME=boutique

# Репозиторий, которому доверяет Workload Identity Federation.
#GITHUB_OWNER=ksyak
#GITHUB_REPOSITORY=ksyak/tms_devops_project

# Пароли. Если не заданы — генерируются при первом запуске и печатаются
# в конце работы скрипта. Задавайте, если нужны предсказуемые значения.
#GRAFANA_PASSWORD=



# Версии чартов. Зафиксированы для воспроизводимости.
#INGRESS_NGINX_VERSION=4.15.1
#ARGOCD_VERSION=10.7.1
